<script>
const SPECIAL_COLORS={'cpu.Tctl':'#ff8c42','cpu.Tdie':'#ff3b30','cpu.W':'#ffd60a','gpu.W':'#f06595'};
const PALETTE=['#4cc9f0','#4895ef','#7b8cff','#b5e48c','#7cb518','#90be6d','#f9c74f','#a3b18a','#d9d2c5','#c77dff','#9d4edd','#ff5d8f','#30d158','#00c2d1','#f2a104','#b388ff','#8ecae6','#ffb347'];
const colorOf={};   // key -> color, assigned once so colors stay stable across polls
function colorFor(k){ if(!colorOf[k]) colorOf[k]=SPECIAL_COLORS[k]||PALETTE[Object.keys(colorOf).length%PALETTE.length]; return colorOf[k]; }
const natSort=(a,b)=>{ const x=+((a.match(/[0-9]+$/)||['0'])[0]), y=+((b.match(/[0-9]+$/)||['0'])[0]); return x-y||a.localeCompare(b); };
// panels are built from the series the daemon actually logs on THIS host:
// a source that is absent (no NVMe, 2 GPUs instead of 3, disks past sdf)
// simply gets no chips and no panel
const GROUP_DEFS=[
  {title:'cpu+gpu power', unit:'W', right:['cpu.W'], pick:ps=>['gpu.W','cpu.W'].filter(k=>ps.has(k))},
  {title:'gpu temps',     pick:ps=>[...ps].filter(k=>/^gpu[0-9]+$/.test(k)).sort(natSort)},
  {title:'cpu temps',     trip:__TRIP__, pick:ps=>['cpu.Tctl','cpu.Tdie'].filter(k=>ps.has(k))},
  {title:'nvme temps',    pick:ps=>[...ps].filter(k=>/^nvme[0-9]+$/.test(k)).sort(natSort)},
  {title:'disk temps',    pick:ps=>[...ps].filter(k=>/^sd[a-z]+$/.test(k)).sort(natSort)}
];
const GAP=10;   // break line if sample gap > GAP s
let DATA=null, HW=null, HW_T=0, hwTabOn=false, hidden=new Set(), winMin=15, PANELS=[], sig='';
const fmtT=t=>new Date(t*1000).toLocaleTimeString([],{hour12:false});
const statusEl=document.getElementById('status');

// ---------- panels (rebuilt only when the set of present series changes) ----------
const panelsEl=document.getElementById('panels');
function buildPanel(g){
  const sec=document.createElement('section');
  sec.className='panel';
  sec.innerHTML='<div class="panel-head"><h2>'+g.title+'</h2><div class="chips"></div></div>'+
    '<div class="chartwrap"><canvas class="chart"></canvas><div class="tip"></div></div>';
  panelsEl.appendChild(sec);
  const cv=sec.querySelector('canvas');
  const p={title:g.title, keys:g.keys, trip:g.trip, unit:g.unit||'°',
           right:new Set(g.right||[]),
           cv, ctx:cv.getContext('2d'), wrap:sec.querySelector('.chartwrap'),
           tip:sec.querySelector('.tip'), chips:sec.querySelector('.chips'),
           hoverT:null, _R:14, chipEls:{}};
  for(const k of p.keys){
    const el=document.createElement('button');
    el.className='chip';
    el.innerHTML='<span class="dot" style="background:'+colorFor(k)+'"></span>'+k+'<b></b>';
    el.onclick=()=>{ hidden.has(k)?hidden.delete(k):hidden.add(k);
      el.classList.toggle('off'); drawPanel(p); };
    p.chips.appendChild(el);
    p.chipEls[k]=el;
  }
  p.cv.addEventListener('mousemove',e=>{
    const WD=windowData(); if(!WD) return;
    const r=p.cv.getBoundingClientRect(), L=46, pw=r.width-L-p._R;
    const t=WD.x0+(e.clientX-r.left-L)/pw*(WD.x1-WD.x0);
    p.hoverT=Math.max(WD.x0,Math.min(WD.x1,t));
    drawPanel(p);
  });
  p.cv.addEventListener('mouseleave',()=>{ p.hoverT=null; drawPanel(p); });
  return p;
}
function syncPanels(present){
  const groups=GROUP_DEFS
    .map(g=>({title:g.title,unit:g.unit,trip:g.trip,right:g.right,keys:g.pick(present)}))
    .filter(g=>g.keys.length);
  const s=groups.map(g=>g.title+':'+g.keys.join(',')).join('|');
  if(s===sig) return;
  sig=s; panelsEl.innerHTML=''; PANELS=groups.map(buildPanel);
}

// ---------- data ----------
async function poll(){
  try{
    const r=await fetch('/api/data',{cache:'no-store'});
    DATA=await r.json();
  }catch(e){ statusEl.className='status bad'; statusEl.textContent='connection lost: '+e; return; }
  if(!DATA.ok){ statusEl.className='status bad'; statusEl.textContent=DATA.error||'no data yet';
    if(sig!==''){ sig=''; panelsEl.innerHTML=''; PANELS=[]; }
    renderChips(); return; }
  const gap=DATA.now-DATA.t1;
  if(gap>15){ statusEl.className='status bad'; statusEl.textContent='⚠ no samples for '+gap+'s — daemon dead or host rebooted?'; }
  else{ statusEl.className='status ok';
    statusEl.textContent='live · last sample '+fmtT(DATA.t1); }
  syncPanels(new Set(Object.keys(DATA.series)));
  if(hwTabOn) loadHardware(false);
  renderChips(); drawAll();
}
setInterval(poll,3000); poll();

function windowData(){
  if(!DATA||!DATA.ok||!Object.keys(DATA.series).length) return null;
  const t0=DATA.t0, t1=DATA.t1;
  const x0=Math.max(t0, t1-winMin*60), x1=t1;
  const events=(DATA.events||[]).filter(([off])=>{const t=t0+off;return t>=x0&&t<=x1;})
    .map(([off,k])=>[t0+off,k]);
  return {t0,x0,x1,events};
}

function seriesPts(p,WD){
  const out={};
  for(const k of p.keys){
    const pts=DATA.series[k]; if(!pts) continue;
    const arr=[];
    for(const [off,v] of pts){ const t=WD.t0+off; if(t>=WD.x0) arr.push([t,v]); }
    if(arr.length) out[k]=arr;
  }
  return out;
}

function renderChips(){
  for(const p of PANELS) for(const k of p.keys){
    const pts=(DATA&&DATA.ok)?DATA.series[k]:null;
    const last=pts&&pts.length?pts[pts.length-1][1]:null;
    p.chipEls[k].querySelector('b').textContent=(last===null?'':last);
    p.chipEls[k].classList.toggle('off',hidden.has(k));
  }
}

// ---------- drawing ----------
function sizeCanvas(p){
  const dpr=window.devicePixelRatio||1;
  const w=p.wrap.clientWidth-16, h=200;
  p.cv.width=w*dpr; p.cv.height=h*dpr;
  p.cv.style.width=w+'px'; p.cv.style.height=h+'px';
  p.ctx.setTransform(dpr,0,0,dpr,0,0);
  return [w,h];
}

function yStep(span){
  for(const s of [1,2,5,10,20,25,50]) if(span/s<=6) return s;
  return 100;
}

function drawPanel(p){
  const [W,H]=sizeCanvas(p);
  const ctx=p.ctx; ctx.clearRect(0,0,W,H);
  const WD=windowData();
  if(!WD){ ctx.fillStyle='rgba(255,255,255,.5)'; ctx.font='14px system-ui';
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText('waiting for sample data…',W/2,H/2); return; }
  const pts=seriesPts(p,WD);
  // per-axis y ranges — the power panel keeps gpu.W on the left axis and
  // cpu.W on the right axis, each auto-scaled to its own data
  const axOf=k=>p.right.has(k)?'R':'L';
  const vmin={L:1e9,R:1e9}, vmax={L:-1e9,R:-1e9};
  for(const k in pts) for(const [t,v] of pts[k]){ const a=axOf(k);
    if(v<vmin[a])vmin[a]=v; if(v>vmax[a])vmax[a]=v; }
  if(p.trip!==undefined){ vmin.L=Math.min(vmin.L,p.trip); vmax.L=Math.max(vmax.L,p.trip); }
  const hasR=p.right.size>0&&isFinite(vmin.R);
  const scale=a=>{
    let lo=vmin[a], hi=vmax[a];
    if(!isFinite(lo)){ lo=0; hi=100; }
    const pad=Math.max(2,(hi-lo)*0.12);
    return [Math.floor((lo-pad)/5)*5, Math.ceil((hi+pad)/5)*5];
  };
  const [y0L,y1L]=scale('L');
  const [y0R,y1R]=hasR?scale('R'):[y0L,y1L];
  const L=46,R=hasR?46:14,T=12,B=24, pw=W-L-R, ph=H-T-B;
  p._R=R;
  const X=t=>L+(t-WD.x0)/(WD.x1-WD.x0)*pw;
  const YL=v=>T+ph-(v-y0L)/(y1L-y0L)*ph;
  const YR=v=>T+ph-(v-y0R)/(y1R-y0R)*ph;
  const Y=(k,v)=>axOf(k)==='R'?YR(v):YL(v);
  ctx.font='11px system-ui';
  for(let v=Math.ceil(y0L/yStep(y1L-y0L))*yStep(y1L-y0L);v<=y1L;v+=yStep(y1L-y0L)){
    ctx.strokeStyle='rgba(255,255,255,.07)';
    ctx.beginPath(); ctx.moveTo(L,YL(v)); ctx.lineTo(W-R,YL(v)); ctx.stroke();
    ctx.fillStyle='rgba(255,255,255,.45)'; ctx.textAlign='right'; ctx.textBaseline='middle';
    ctx.fillText(Math.round(v)+p.unit,L-6,YL(v));
  }
  if(hasR){
    for(let v=Math.ceil(y0R/yStep(y1R-y0R))*yStep(y1R-y0R);v<=y1R;v+=yStep(y1R-y0R)){
      ctx.fillStyle='rgba(255,214,10,.7)'; ctx.textAlign='left'; ctx.textBaseline='middle';
      ctx.fillText(Math.round(v)+p.unit,W-R+6,YR(v));
    }
  }
  const span=WD.x1-WD.x0, units=[10,15,30,60,120,300];
  const step=units.find(u=>span/u<=8)||600;
  ctx.textAlign='center'; ctx.textBaseline='top';
  for(let t=Math.ceil(WD.x0/step)*step;t<=WD.x1;t+=step){
    ctx.strokeStyle='rgba(255,255,255,.07)';
    ctx.beginPath(); ctx.moveTo(X(t),T); ctx.lineTo(X(t),T+ph); ctx.stroke();
    ctx.fillStyle='rgba(255,255,255,.45)'; ctx.fillText(fmtT(t),X(t),T+ph+5);
  }
  if(p.trip!==undefined&&p.trip>=y0L&&p.trip<=y1L){
    ctx.setLineDash([6,4]); ctx.strokeStyle='rgba(255,59,48,.8)'; ctx.lineWidth=1.2;
    ctx.beginPath(); ctx.moveTo(L,YL(p.trip)); ctx.lineTo(W-R,YL(p.trip)); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle='rgba(255,59,48,.9)'; ctx.textAlign='right'; ctx.textBaseline='bottom';
    ctx.fillText('cpu trip '+p.trip+p.unit,W-R-4,YL(p.trip)-3);
  }
  for(const [t,kind] of WD.events){
    ctx.setLineDash([4,4]);
    ctx.strokeStyle=kind==='start'?'rgba(48,209,88,.7)':kind==='stop'?'rgba(255,159,10,.8)':'rgba(255,255,255,.18)';
    ctx.beginPath(); ctx.moveTo(X(t),T); ctx.lineTo(X(t),T+ph); ctx.stroke(); ctx.setLineDash([]);
    if(kind!=='rotated'){ ctx.fillStyle=kind==='start'?'rgba(48,209,88,.9)':'rgba(255,159,10,.9)';
      ctx.textAlign='left'; ctx.textBaseline='top'; ctx.fillText(kind,X(t)+3,T+2); }
  }
  for(const k of p.keys){
    if(hidden.has(k)) continue;
    const a=pts[k]; if(!a||!a.length) continue;
    ctx.strokeStyle=colorFor(k); ctx.lineWidth=1.8; ctx.lineJoin='round';
    ctx.beginPath();
    let pen=false, prev=null;
    for(const [t,v] of a){
      if(!pen||prev!==null&&(t-prev)>GAP){ ctx.moveTo(X(t),Y(k,v)); pen=true; }
      else ctx.lineTo(X(t),Y(k,v));
      prev=t;
    }
    ctx.stroke();
    if(a.length===1){ ctx.fillStyle=colorFor(k);
      ctx.beginPath(); ctx.arc(X(a[0][0]),Y(k,a[0][1]),2.5,0,7); ctx.fill(); }
  }
  if(p.hoverT!==null&&p.hoverT>=WD.x0&&p.hoverT<=WD.x1){
    ctx.strokeStyle='rgba(255,255,255,.35)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(X(p.hoverT),T); ctx.lineTo(X(p.hoverT),T+ph); ctx.stroke();
    const rows=[];
    for(const k of p.keys){
      if(hidden.has(k)) continue;
      const a=pts[k]; if(!a) continue;
      let best=null, bd=1e9;
      for(const [t,v] of a){ const d=Math.abs(t-p.hoverT); if(d<bd){bd=d;best=[t,v];} }
      if(best&&bd<=5) rows.push([k,best[1],COLORS[k]]);
    }
    rows.sort((a,b)=>b[1]-a[1]);
    if(rows.length){
      p.tip.innerHTML='<div class="tt-t">'+fmtT(p.hoverT)+'</div>'+
        rows.map(r=>'<div class="tt-r"><span class="dot" style="background:'+r[2]+'"></span>'+r[0]+'<b>'+r[1]+p.unit+'</b></div>').join('');
      p.tip.style.display='block';
      const tx=p.cv.offsetLeft+X(p.hoverT);
      p.tip.style.left=(tx+14>W*0.72? tx-p.tip.offsetWidth-14 : tx+14)+'px';
      p.tip.style.top=(p.cv.offsetTop+T+8)+'px';
    } else p.tip.style.display='none';
  } else p.tip.style.display='none';
}

function drawAll(){ for(const p of PANELS) drawPanel(p); }

// ---------- hardware tab (knob -> device identity) ----------
const hwBody=document.getElementById('hw-body');
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
async function loadHardware(force){
  if(!force&&HW&&Date.now()-HW_T<60000) return;
  try{
    const r=await fetch('/api/hardware',{cache:'no-store'});
    const j=await r.json();
    if(j.ok){ HW=j.hardware; HW_T=Date.now(); }
  }catch(e){}
  renderHardware();
}
// dot color = the line color of the matching live series (nvme0n1 disk row
// matches the nvme0 temp line)
function knobColor(k){ const m=k.match(/^nvme([0-9]+)n\d*$/); return colorFor(m?'nvme'+m[1]:k); }
function renderHardware(){
  if(!HW){ hwBody.innerHTML='<p class="muted">No hardware inventory yet — the daemon writes it at startup.</p>'; return; }
  const zone=HW.power_zone==='none'?'<span class="muted">no RAPL zone (cpu.W unavailable)</span>':esc(HW.power_zone);
  const sens=HW.cpu_sensor==='none'?'<span class="muted">none found</span>':esc(HW.cpu_sensor);
  let h='<div class="hwinfo">host <b>'+esc(HW.host)+'</b> · '+(HW.cpu?esc(HW.cpu):'cpu unknown')
